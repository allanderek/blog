{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
  <link href="{{ .Permalink }}rss" rel="self"/>
  <link href="{{ .Permalink }}"/>
  <updated>{{ now.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
  <id>{{ .Permalink }}</id>
  {{/* site.Author was removed in Hugo 0.158. It read a top-level [author]
       table, which this site does not have, so it was always empty and the
       title fallback below is what actually rendered. The author is declared
       under [params], which is what these now read. */}}
  <author>
    <name>{{ site.Params.author | default site.Title }}</name>
    {{ with site.Params.email }}<email>{{ . }}</email>{{ end }}
  </author>
  <generator>Hugo -- gohugo.io</generator>
  {{ range where .Site.RegularPages "Type" "in" .Site.Params.mainSections | first 20 }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}"/>
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
    {{ with site.Params.author }}<author><name>{{ . }}</name></author>{{ end }}
    <content type="html">{{ .Content | html }}</content>
    {{ with .Params.tags }}
    {{ range . }}
    <category term="{{ . }}"/>
    {{ end }}
    {{ end }}
  </entry>
  {{ end }}
</feed>
